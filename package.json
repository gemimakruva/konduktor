{
  "name": "konduktor-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source orchestrator for Claude Code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gemimakruva/konduktor"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "start": "node packages/cli/dist/index.js start --open",
    "konduktor": "node packages/cli/dist/index.js",
    "publish:all": "pnpm build && pnpm -r publish --access public"
  },
  "engines": { "node": ">=20" }
}
